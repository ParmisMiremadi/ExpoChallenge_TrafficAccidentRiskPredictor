# Copy this file to `.env` and fill in your own keys. NEVER commit `.env`.
# The app runs fine WITHOUT any of these — every key below only upgrades a
# feature that already has a free, keyless fallback.

# Jina AI Reader (https://jina.ai) — reads a web page as clean text.
JINA_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Verify this model name in Google AI Studio; change if needed.
GEMINI_MODEL=gemini-2.5-flash-lite

# The page Jina should read for traffic/highway news. Leave blank to disable
# the LLM news layer (NWS weather alerts still work).
NEWS_URL=

# OpenRouteService (https://openrouteservice.org/dev/#/signup) — free key,
# used by Safe Routing for reliable routes with alternatives. Without it,
# routing falls back to the public OSRM demo server (keyless, but slower and
# sometimes rate-limited).
ORS_API_KEY=
