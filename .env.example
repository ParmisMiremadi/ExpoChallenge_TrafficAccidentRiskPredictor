# Copy this file to `.env` and fill in your own keys. NEVER commit `.env`.
# The app runs fine WITHOUT these — the news ticker falls back to the
# National Weather Service live alerts (free, no key). These keys only add
# the Jina + Gemini traffic/highway news summaries on top.

# Jina AI Reader (https://jina.ai) — reads a web page as clean text.
JINA_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Verify this model name in Google AI Studio; change if needed.
GEMINI_MODEL=gemini-2.5-flash-lite

# The page Jina should read for traffic/highway news. Leave blank to disable
# the LLM news layer (NWS weather alerts still work).
NEWS_URL=
